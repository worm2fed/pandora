{
  "version": 2,
  "db": ".claude/shipgate.db",
  "ledger": "docs/ledger.md",
  "artifact_homes": {
    "worklog": "*/docs/prd/*.worklog.md",
    "prd": "*/docs/prd/*.md",
    "adr": "*/docs/adr/*.md"
  },
  "enforce": {
    "stop_gate": true,
    "auto_capture": true
  },
  "autonomy": "executive",
  "orchestration": {
    "review": "workflow",
    "explore": "workflow"
  },
  "code_signals": {
    "window_months": 12,
    "exclude": [
      "shipgate/evals/"
    ]
  },
  "forge": "github"
}
